# Build output
artifacts/
bin/
obj/
out/
dist/
_publish/
*.wixpdb

# Packaged output. The installer and the engine executable are built, not stored:
# the engine embeds a language runtime and is far too large to belong in history.
*.msi
*.exe
*.blob
sea-config.json

# The installer's payload is staged from a fresh build immediately before packaging.
# Committing it would put stale binaries in history and let a release ship them.
installer/Xlide.Setup/payload/

# Node
node_modules/
npm-debug.log*
.npm/

# IDE and editor state
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs

# Test and harness output
TestResults/
harness-runs/
*.trx
*.received.*
tools/harness/fixtures/*.xlsx
~$*.xls*

# Local-only configuration and anything holding credentials
*.local.json
.env
*.pfx
*.snk

# Operating system noise
Thumbs.db
desktop.ini
.DS_Store
ui/editor/.build-number

# Generated by tools\New-RenameFixture.ps1; rebuilt on demand rather than committed.
artifacts/fixtures/

# Editor and agent scratch, never the repo's business.
.claude/
