{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The spec repo's smart-editing helpers, bundled from a vendored copy of its sources by
    // build.mjs (its esbuild alias points at vendor/xlide-spec) but type-checked against local
    // declarations, because the spec compiles under its own compiler settings, not this
    // project's stricter ones. The declarations live in src/spec/xlide-spec, and vendor/README.md
    // explains how the copy is kept in step with the repo it came from.
    "paths": {
      "xlide-spec/*": ["./src/spec/xlide-spec/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
