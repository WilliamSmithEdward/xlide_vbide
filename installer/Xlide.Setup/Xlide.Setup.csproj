<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Xlide.Setup</RootNamespace>
    <AssemblyName>xlide-setup</AssemblyName>
    <Description>Single-file installer for xlide. Installs per user and needs no administrator rights.</Description>

    <!-- Built by tools\Generate-Icon.ps1 from assets\images. This is the only executable a user
         ever sees before anything is installed, so it should not wear the default one. -->
    <ApplicationIcon>xlide.ico</ApplicationIcon>

    <!-- The installer is itself native, so a user who has nothing installed can still run it. -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StackTraceSupport>true</StackTraceSupport>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Xlide.Vbe.Core\Xlide.Vbe.Core.csproj" />
  </ItemGroup>

  <!--
    Everything the product needs is carried inside this executable. The payload folder is filled by
    installer\build.ps1 immediately before the build. Building with an empty payload is allowed so
    the installer can be compiled and its logic tested without a full product build; it refuses to
    install in that state rather than producing a broken installation.
  -->
  <ItemGroup>
    <EmbeddedResource Include="payload\**\*" LogicalName="payload/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
