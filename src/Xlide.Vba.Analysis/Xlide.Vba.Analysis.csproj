<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Deliberately not Windows specific and with no dependency on the add-in. The analyzer is pure:
      it reads text and returns findings. That is what lets it be tested by the thousand without a
      host, on any machine, in a second.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Xlide.Vba.Analysis</RootNamespace>
    <Description>VBA language analysis: lexer, parser, symbols, and diagnostics.</Description>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
