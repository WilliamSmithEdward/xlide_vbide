<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>Xlide.Vbe.Shim</RootNamespace>
    <AssemblyName>Xlide.Vbe.Shim</AssemblyName>
    <Description>Native COM in-process server the Visual Basic Editor loads as an add-in.</Description>

    <!-- Compiled ahead of time to a native library so no .NET runtime is loaded into Excel. -->
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- The VBE is a single-threaded apartment host. Nothing here may assume a thread pool. -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <EnableComHosting>false</EnableComHosting>

    <!-- Trim aggressively: this library ships inside a user-visible installer. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <StackTraceSupport>true</StackTraceSupport>

    <!--
      Exception messages keep their WORDS.

      UseSystemResourceKeys was true here, which strips the message text and leaves the resource
      key, so every failure this product reports to a developer arrived as an identifier: a file
      held open by another program came back as "IO_SharingViolation_File" in the import/export
      dialog, and every ex.Message in the log is the same. Measured before changing it: the words
      cost 23,040 bytes, 0.3% of this library and 0.08% of the installer (2026-08-09).
    -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Which native loader to deploy. A publish names the runtime identifier; a plain build does not,
      so the platform decides. Getting this wrong produces a library the host cannot load at all
      rather than a build error.
    -->
    <WebView2LoaderRuntime Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</WebView2LoaderRuntime>
    <WebView2LoaderRuntime Condition="'$(WebView2LoaderRuntime)' == '' and '$(Platform)' == 'x86'">win-x86</WebView2LoaderRuntime>
    <WebView2LoaderRuntime Condition="'$(WebView2LoaderRuntime)' == ''">win-x64</WebView2LoaderRuntime>
    <WebView2LoaderPath>$(PkgMicrosoft_Web_WebView2)\runtimes\$(WebView2LoaderRuntime)\native\WebView2Loader.dll</WebView2LoaderPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xlide.Vbe.Core\Xlide.Vbe.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The package is referenced for one file: the native WebView2Loader.dll under
      runtimes\<rid>\native. Everything else in it is managed - the WinForms and WPF wrappers and
      the .NET projection - and none of it can be used from an ahead-of-time compiled native
      library. ExcludeAssets keeps all of that out of the compilation while still restoring the
      package, and GeneratePathProperty gives the extracted location so the one file can be picked
      out by hand.

      The loader is deployed beside the shim rather than relied on to be discoverable. The runtime
      itself is installed machine-wide and found by the loader, but the loader is not on any search
      path the host process uses.
    -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup Condition="'$(PkgMicrosoft_Web_WebView2)' != ''">
    <None Include="$(WebView2LoaderPath)"
          Link="WebView2Loader.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The editor bundle, served under a virtual host name rather than read as files, which is why it
      has to sit at a known place beside the shim. It is built by a separate toolchain and may not
      exist yet in a working tree that has not produced it, so the glob deliberately matches nothing
      rather than failing the build; the shim reports the absence at run time.
    -->
    <None Include="$(MSBuildThisFileDirectory)..\..\ui\editor\dist\**\*"
          LinkBase="ui\editor\dist"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />

    <!-- Loaded at run time to dress the editor's title bar. A file rather than an embedded Win32
         resource because this is a library, and the shell reads a window's icon from the handle it
         is given rather than from whatever produced it. -->
    <None Include="$(MSBuildThisFileDirectory)..\..\assets\xlide.ico"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="VerifyWebView2Loader" AfterTargets="Build">
    <Error Condition="!Exists('$(WebView2LoaderPath)')"
           Text="The native WebView2 loader was not found at $(WebView2LoaderPath). Restore the Microsoft.Web.WebView2 package." />
  </Target>

</Project>
